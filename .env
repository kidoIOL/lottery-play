# ===========================================
# LKO Thrift Ticket - M-Pesa Daraja Credentials
# ===========================================
# Get these from https://developer.safaricom.co.ke

# Your Consumer Key & Consumer Secret
CONSUMER_KEY=your_consumer_key_here
CONSUMER_SECRET=your_consumer_secret_here

# Business Shortcode (Paybill or Till)
# Sandbox default: 174379
BUSINESS_SHORTCODE=174379

# Lipa Na M-Pesa Online Passkey
# Sandbox default: bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Environment: sandbox or production
MPESA_ENV=sandbox

# Your public callback URL (must be HTTPS in production)
# For local testing use ngrok: https://xxxx.ngrok-free.app/api/mpesa/callback
CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Server port
PORT=3000

# Ticket price in KSh
TICKET_AMOUNT=30
